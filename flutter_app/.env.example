# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Live-share viewer (public web page non-app recipients open from SMS).
# Deploy flutter_app/web-viewer/ (see its README.md) and paste the URL
# your host assigned here, with NO trailing slash. Recipients receive
# links shaped like <LIVE_SHARE_BASE_URL>/s/<token>.
#   - Render:  https://live-share-viewer.onrender.com
#   - Netlify: https://your-site.netlify.app
#   - Local:   http://<your-lan-ip>:8080  (via web-viewer/local-server.js)
# If unset, the app falls back to the Supabase Edge Function URL — but
# Supabase sandboxes HTML on their shared domain, so browsers show raw
# source instead of a rendered map. This var is REQUIRED for the viewer.
LIVE_SHARE_BASE_URL=https://live-share-viewer.onrender.com

# API Configuration (Elysia Backend)
#
# Development only:
#   10.0.2.2 is the Android emulator loopback to the host machine.
#   Use http://localhost:3001 for iOS simulator or physical devices on LAN.
#
# Production:
#   Replace with your HTTPS/WSS endpoint. Never ship a release build with
#   these development defaults — main.dart now hard-fails release builds
#   that are missing SUPABASE_URL / SUPABASE_ANON_KEY for the same reason.
API_BASE_URL=http://10.0.2.2:3001
WS_BASE_URL=ws://10.0.2.2:3001

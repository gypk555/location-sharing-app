# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Live-share viewer (public web page non-app recipients open from SMS).
# Deploy flutter_app/web-viewer/ to Vercel/Netlify and paste the assigned
# URL here (no trailing slash). Recipients receive links shaped like
# <LIVE_SHARE_BASE_URL>/s/<token>. If unset, the app falls back to the
# Supabase Edge Function URL — but Supabase sandboxes HTML on their
# shared domain so browsers show source instead of a rendered page.
# See flutter_app/web-viewer/README.md for the full story.
LIVE_SHARE_BASE_URL=https://your-viewer.vercel.app

# API Configuration (Elysia Backend)
#
# Development only:
#   10.0.2.2 is the Android emulator loopback to the host machine.
#   Use http://localhost:3001 for iOS simulator or physical devices on LAN.
#
# Production:
#   Replace with your HTTPS/WSS endpoint. Never ship a release build with
#   these development defaults — main.dart now hard-fails release builds
#   that are missing SUPABASE_URL / SUPABASE_ANON_KEY for the same reason.
API_BASE_URL=http://10.0.2.2:3001
WS_BASE_URL=ws://10.0.2.2:3001
